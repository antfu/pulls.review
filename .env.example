# Use your HTTPS origin in production; terminate TLS at a reverse proxy.
PUBLIC_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 characters; keep stable to decrypt stored OAuth tokens.
SESSION_SECRET=
CONFIG_ENCRYPTION_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Optional host provider. Repository automation remains opt-in.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
PULLS_REVIEW_API_KEY=
PULLS_REVIEW_PROVIDER=
PULLS_REVIEW_MODEL=
PULLS_REVIEW_LOCALE=en
PULLS_REVIEW_BASE_URL=
# Keep false during import rehearsals; true enables the durable job runner.
ANALYSIS_RUNNER_ENABLED=true
