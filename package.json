    "@iconify-json/ph": "catalog:icons",
    "@iconify-json/twemoji": "catalog:icons",
    "@pierre/diffs": "catalog:frontend",
    "@shikijs/engine-javascript": "catalog:",
    "@storybook/vue3-vite": "catalog:storybook",
    "@tanstack/vue-virtual": "catalog:frontend",
    "@types/node": "catalog:dev",
