{
  "name": "@pulls.review/monorepo",
  "type": "module",
  "version": "0.3.4",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "Review pull requests with grouped, summarized, and beautiful diffs.",
  "author": "Anthony Fu <hi@antfu.me>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://diffwise.shyim.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/pulls.review.git"
  },
  "bugs": "https://github.com/antfu/pulls.review/issues",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -F @pulls.review/app run dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "bumpp -r",
    "prepare": "skills experimental_sync -y",
    "storybook": "pnpm -F @pulls.review/app run storybook",
    "i18n:check": "x18n check",
    "docker:build": "docker build -t pulls-review .",
    "db:backup": "node scripts/database.mjs backup"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@antfu/skills": "catalog:agentic",
    "@types/node": "catalog:dev",
    "@unocss/eslint-config": "catalog:build",
    "@x18n/cli": "catalog:dev",
    "bumpp": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "eslint-plugin-slop": "catalog:dev",
    "eslint-plugin-sonarjs": "catalog:dev",
    "skills": "catalog:agentic",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  }
}
