{
  "name": "pulls.review",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "description": "Review pull requests with grouped, summarized, and beautiful diffs.",
  "author": "Anthony Fu <hi@antfu.me>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://pulls.review",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/pulls.review.git"
  },
  "bugs": "https://github.com/antfu/pulls.review/issues",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:embed && vite build",
    "build:embed": "vite build --config vite.config.embed.ts",
    "dev": "vite",
    "play:embed": "pnpm run build:embed && vite --open /playgrounds/embed/",
    "preview": "vite preview",
    "start:generate": "npx serve dist",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
