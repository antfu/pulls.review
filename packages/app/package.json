{
  "name": "@pulls.review/app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Review pull requests with grouped, summarized, and beautiful diffs.",
  "author": "Anthony Fu <hi@antfu.me>",
  "license": "MIT",
  "homepage": "https://pulls.review",
  "scripts": {
    "build": "pnpm run build:embed && vite build",
    "build:embed": "vite build --config vite.config.embed.ts",
    "dev": "vite",
    "play:embed": "pnpm run build:embed && vite --open /playgrounds/embed/",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
