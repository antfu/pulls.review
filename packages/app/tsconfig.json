{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@pulls.review/core": ["../core/src/index.ts"],
      "@pulls.review/core/llm": ["../core/src/llm.ts"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "scripts/**/*.ts",
    "vite.config.ts",
    "vite.config.embed.ts",
    "vitest.config.ts",
    "uno.config.ts"
  ]
}
