{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@pulls.review/core/*": ["../core/src/*.ts"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "vueCompilerOptions": {
    "plugins": [
      "vue-router/volar/sfc-route-blocks",
      {
        "name": "vue-router/volar/sfc-typed-router",
        "options": { "rootDir": "../.." }
      }
    ]
  },
  "include": [
    "./typed-router.d.ts",
    "./typed-router.local.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "scripts/**/*.ts",
    "vite.config.ts",
    "vite.config.embed.ts",
    "vite.config.local.ts",
    "vitest.config.ts",
    "vitest.local.config.ts",
    "uno.config.ts"
  ]
}
