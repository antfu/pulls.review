{
  "name": "pulls.review",
  "type": "module",
  "version": "0.2.1",
  "description": "Review local git changes - the working tree, a commit or any range - grouped and summarized in the browser.",
  "author": "Anthony Fu <hi@antfu.me>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://pulls.review",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/pulls.review.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/antfu/pulls.review/issues",
  "keywords": [
    "pull-request",
    "code-review",
    "git",
    "devframe"
  ],
  "exports": {
    "./devframe": "./dist/devframe.mjs"
  },
  "bin": {
    "pulls.review": "./bin.mjs",
    "pulls-review": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown && pnpm -F @pulls.review/app run build:local",
    "dev": "node bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pulls.review/core": "workspace:^",
    "devframe": "catalog:frontend",
    "h3": "catalog:frontend",
    "unstorage": "catalog:frontend",
    "valibot": "catalog:frontend"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "catalog:frontend",
    "@earendil-works/pi-ai": "catalog:frontend",
    "@types/node": "catalog:dev",
    "@valibot/to-json-schema": "catalog:frontend",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  }
}
